kind: Deployment
metadata:
  name: enlearn
spec:
  replicas: 2
  selector:
    matchLabels:
      app: enlearn
  template:
    metadata:
      labels:
        app: enlearn
    spec:
      containers:
      - name: enlearn
        image: ghcr.io/<owner>/enlearn:{{ .Chart.AppVersion }}
        ports:
        - containerPort: 8080
