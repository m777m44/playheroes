fun FlashcardScreen(
    words: List<WordCard>,
    onCorrect: () -> Unit,
    onWrong: () -> Unit
) {
    val currentIndex = remember { mutableStateOf(0) }
    val currentCard = words[currentIndex.value]

    Column(
        verticalArrangement = Arrangement.Center,
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Image(painter = painterResource(id = currentCard.imageRes),
            contentDescription = null,
            modifier = Modifier.size(150.dp))
        Spacer(Modifier.height(16.dp))
        Text(text = currentCard.translation)

        Row(Modifier.padding(top = 32.dp)) {
            Button(onClick = {
                if (currentCard.isCorrect) onCorrect() else onWrong()
            }) {
                Text("أنا أعرف هذا")
            }
            Spacer(Modifier.width(16.dp))
            Button(onClick = {
                // skip
                currentIndex.value = (currentIndex.value + 1) % words.size
            }) {
                Text("تجاوز")
            }
        }
    }
}
